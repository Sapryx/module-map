  "notes": [
    { "level": "bad", "tag": "Cycle", "title": "Audio player and playlists", "text": "IAudioPlayer takes and reports IPlaylistItem, while PlaybackQueue calls IAudioPlayer to skip or stop. Neither can be moved without the other." },
    { "level": "bad", "tag": "Cycle", "title": "Track rows and track editor", "text": "TrackControlVm opens TrackEditorVm, and TrackEditorVm saves back through TrackControlVm.ApplyEditAsync, which only forwards to TrackMetadataEditor." },
    { "level": "warn", "tag": "Concrete dependency", "title": "Track metadata editor", "text": "Lives in Core.Storage.Tags but depends on IAudioPlayer to release files and on the concrete TagLibMetadataLoader for the empty-title rule. ArtistRegistry and three view models subscribe to its concrete MetadataChanged event; there is no interface." },
    { "level": "warn", "tag": "Reach across areas", "title": "Loudness scan", "text": "A Playback module that needs Storage (IDegreeOfParallelismProvider), Tags (IMetadataSaver) and the player. It is the least portable piece of Core." },
    { "level": "warn", "tag": "Model leak", "title": "Track model", "text": "Metadata.Loudness is a TrackLoudness from Core.Playback.Loudness, so the shared track model and the tag adapter both depend on the loudness area." },
    { "level": "warn", "tag": "Static hand-off", "title": "Animation settings to theme", "text": "The app writes StaticResource entries into the theme's static AnimationResources.Entries before XAML loads. The theme project cannot animate on its own." },
    { "level": "ok", "tag": "Port and adapter", "title": "Keyboard layouts", "text": "Core owns IKeyboardLayoutProvider; the app implements it per OS. This crossing is intentional and keeps Core free of Win32 and Wayland." },
    { "level": "ok", "tag": "Seams", "title": "Player and LibVLC, Discord, UI thread", "text": "IMediaEngine, IDiscordClient and IUiDispatcher isolate LibVLC, the Discord library and Avalonia's dispatcher, so the modules behind them are tested without the real thing." }
  ]
}
